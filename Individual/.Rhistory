library(tidyr)
library(purrr)
library(stringr)
read_cricsheet_json <- function(path) {
# Read JSON (flattening not needed)
js <- fromJSON(path)
#############################################
# 1. MATCH METADATA
#############################################
meta <- tibble(
match_id   = js$meta$match_id %||% NA,
data_version = js$meta$data_version %||% NA,
created     = js$meta$created %||% NA,
revision    = js$meta$revision %||% NA,
venue       = js$info$venue %||% NA,
city        = js$info$city %||% NA,
event_name  = js$info$event$name %||% NA,
gender      = js$info$gender %||% NA,
match_type  = js$info$match_type %||% NA,
overs       = js$info$overs %||% NA,
team1       = js$info$teams[[1]] %||% NA,
team2       = js$info$teams[[2]] %||% NA,
toss_winner = js$info$toss$winner %||% NA,
toss_decision = js$info$toss$decision %||% NA,
winner      = js$info$outcome$winner %||% NA,
outcome_method = names(js$info$outcome)[names(js$info$outcome) != "winner"] %||% NA
)
#############################################
# 2. INNINGS SUMMARY TABLE
#############################################
inns <- js$innings
innings_summary <- map_dfr(seq_along(inns), function(i) {
tibble(
inning_number = i,
team = inns[[i]]$team,
total_runs = inns[[i]]$runs,
wickets = inns[[i]]$wickets,
overs = inns[[i]]$overs
)
})
#############################################
# 3. BALL-BY-BALL DATA
#############################################
# Each innings has deliveries: list of named single-element lists like "0.1", "0.2"...
ball_by_ball <- map_dfr(seq_along(inns), function(i) {
deliveries <- inns[[i]]$deliveries
map_dfr(deliveries, function(deliv) {
ball_id <- names(deliv)
d <- deliv[[1]]   # actual content
tibble(
inning = i,
team = inns[[i]]$team,
over = as.integer(str_extract(ball_id, "^[0-9]+")),
ball = as.integer(str_extract(ball_id, "(?<=\\.)[0-9]+")),
# standard ball info
batter = d$batter %||% NA,
bowler = d$bowler %||% NA,
non_striker = d$non_striker %||% NA,
# runs
runs_batter = d$runs$batter %||% 0,
runs_extras = d$runs$extras %||% 0,
runs_total  = d$runs$total %||% 0,
# optional extras
extras_type = if (!is.null(d$extras)) names(d$extras)[1] else NA,
# wicket info (if applicable)
wicket_kind = if (!is.null(d$wickets)) d$wickets[[1]]$kind else NA,
wicket_player_out = if (!is.null(d$wickets)) d$wickets[[1]]$player_out else NA,
wicket_fielders = if (!is.null(d$wickets)) {
paste(unlist(d$wickets[[1]]$fielders), collapse = ",")
} else NA
)
})
})
return(list(
meta = meta,
innings = innings_summary,
balls = ball_by_ball
))
}
exampleMatch <- read_cricsheet_json("matches/1460884.json")
