# Read in data
data <- read.csv("dog_breed_health_data.csv")
#Set empty strings to be NA
data[data == ""] <- NA
# Make character columns into factor columns
data[sapply(data, is.character)] <- lapply(data[sapply(data, is.character)], factor)
# Remove NA rows (which includes rows with empty strings)
data <- data[complete.cases(data), ]
# sample 3/4 of the indices from data
set.seed(123)
train_idx <- sample(1:nrow(data), size = 0.75*nrow(data))
# set training data to be the training indices and the rest as test data.
train_data <- data[train_idx, ]
test_data <- data[-train_idx, ]
get_fold_j_of_k <- function(X, G, j, K, seed)
{
# set seed for reproducibility
set.seed(seed)
# randomly assign each (X,G) observation to one of the K folds
# this is a vector of random samples from 1:k
fold_assignments <- sample(rep(1:K, length.out=nrow(X)))
# Set the validation dataframes equal to the rows that have been assigned to fold j
validation_idx <- which(fold_assignments == j)
X_val_fold <- X[validation_idx, ]
G_val_fold <- G[validation_idx]
# Set the training dataframes equal to the rows that have not been assigned to fold j
train_idx <- which(fold_assignments != j)
X_train_folds <- X[train_idx, ]
G_train_folds <- G[train_idx]
# return dataframes as a list
return(list(
X_val_fold = X_val_fold,
G_val_fold = G_val_fold,
X_train_folds = X_train_folds,
G_train_folds = G_train_folds
))
}
library(e1071)
# initialise vectors of parameter values
c_vals <- c(-1, 0, 1)
d <- c(1, 2, 3, 4, 5)
# 10-fold Cross-Validation
K <- 10
# Training labels
G_train <- train_data$Healthy
# Define our two feature sets
X_train_S1 <- train_data[, c("Age", "Weight..lbs.")]
X2_df <- train_data[, setdiff(names(train_data), c("ID", "Healthy", "Age", "Weight..lbs.")), drop=FALSE]
X_train_S2 <- model.matrix(~ . - 1, data = X2_df)  # one-hot encoding
feature_sets <- list(S1 = X_train_S1, S2 = X_train_S2)
feature_set_names <- c("S1", "S2")
# Construct a 3D array with dimensions (c, d, feature_set) for storing the corresponding CV errors.
# This is a 3x5x2 array
CVerrors <- array(
NA,
dim = c(length(c_vals), length(d), length(feature_sets)),
dimnames = list(
c = as.character(c_vals),
d = as.character(d),
fs = feature_set_names
)
)
system.time(
{}
for (j in 1:K)
get_fold_j_of_k <- function(X, G, j, K, seed)
{
# set seed for reproducibility
set.seed(seed)
# randomly assign each (X,G) observation to one of the K folds
# this is a vector of random samples from 1:k
fold_assignments <- sample(rep(1:K, length.out=nrow(X)))
# Set the validation dataframes equal to the rows that have been assigned to fold j
validation_idx <- which(fold_assignments == j)
X_val_fold <- X[validation_idx, ]
G_val_fold <- G[validation_idx]
# Set the training dataframes equal to the rows that have not been assigned to fold j
train_idx <- which(fold_assignments != j)
X_train_folds <- X[train_idx, ]
G_train_folds <- G[train_idx]
# return dataframes as a list
return(list(
X_val_fold = X_val_fold,
G_val_fold = G_val_fold,
X_train_folds = X_train_folds,
G_train_folds = G_train_folds
))
}
system.time({
for (j in 1:K)
{
fold_data <- get_fold_j_of_k(X_train, G_train, j, K, seed=1)
model <- svm(
x = fold_data$X_train_folds,
y = fold_data$G_train_folds,
kernel="polynomial",
degree = 1,
coef0 = 1,
)
preds <- predict(model, fold_data$X_val_fold)
fold_errors[j] <- mean(preds != fold_data$G_val_fold)
}
})
