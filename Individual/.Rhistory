col  = ifelse(grid_preds == "Yes", "lightyellow", "lightblue"),
pch  = 20, cex = 0.3,
xlab = "Age", ylab = "Weight (lbs)",
main = paste("SVM Decision Boundary (S1): c =", best_c_S1, ", d =", best_d_S1))
set.seed(1)
sample_idx <- sample(1:nrow(X_train_S1), 100)
sample_X   <- X_train_S1[sample_idx, ]
sample_G   <- G_train[sample_idx]
points(sample_X$Age, sample_X$Weight..lbs.,
col = ifelse(sample_G == "Yes", "orange", "blue"),
pch = 16, cex = 0.8)
legend("topright",
legend = c("Boundary: Yes", "Boundary: No", "Train: Yes", "Train: No"),
col    = c("lightyellow", "lightblue", "orange", "blue"),
pch    = c(20, 20, 16, 16))
legend("topright", legend=c("Train: Healthy", "Train: Not Healthy"),col=c("orange", "blue"), pch=c(6, 16))
legend("topright", legend=c("Train: Healthy", "Train: Not Healthy"),col=c("orange", "blue"), pch=c(16, 16))
best_idx_S2 <- which(S2_errors == min(S2_errors), arr.ind = TRUE)
best_idx_S2 <- which(S2_errors == min(S2_errors), arr.ind = TRUE)
best_c_S2   <- c_vals[best_idx_S2[1]]
best_d_S2   <- d[best_idx_S2[2]]
cat("Best S2 model: c =", best_c_S2, ", d =", best_d_S2, "\n")
cat("CV Error:", min(S2_errors), "\n")
# Train best S2 model on full training data
best_model_S2 <- svm(
x      = X_train_S2,
y      = G_train,
kernel = "polynomial",
degree = best_d_S2,
coef0  = best_c_S2,
scale  = TRUE
)
# Prepare test data
X_test_df <- test_data[, setdiff(names(test_data), c("ID", "Healthy")), drop = FALSE]
X_test_S2 <- model.matrix(~ . - 1, data = X_test_df)
G_test    <- test_data$Healthy
# Confusion matrix and accuracy on test data
test_preds_S2  <- predict(best_model_S2, X_test_S2)
conf_matrix_S2 <- table(Predicted = test_preds_S2, Actual = G_test)
# Prepare test data
X_test_df <- test_data[, setdiff(names(test_data), c("ID", "Healthy", "Age", "Weight..lbs.")), drop = FALSE]
X_test_S2 <- model.matrix(~ . - 1, data = X_test_df)
G_test    <- test_data$Healthy
# Confusion matrix and accuracy on test data
test_preds_S2  <- predict(best_model_S2, X_test_S2)
conf_matrix_S2 <- table(Predicted = test_preds_S2, Actual = G_test)
accuracy_S2    <- mean(test_preds_S2 == G_test)
print(conf_matrix_S2)
cat("Test Accuracy:", round(accuracy_S2, 4), "\n")
