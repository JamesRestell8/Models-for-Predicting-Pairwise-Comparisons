best_d_S1  <- d_vals[best_idx[2]]
cat("Best S1 model: c =", best_c_S1, ", d =", best_d_S1, "\n")
best_d_S1  <- d[best_idx[2]]
cat("Best S1 model: c =", best_c_S1, ", d =", best_d_S1, "\n")
# Train best S1 model on full training data
best_model_S1 <- svm(
x      = X_train_S1,
y      = G_train,
kernel = "polynomial",
degree = best_d_S1,
coef0  = best_c_S1,
cost   = 1,
scale  = TRUE
)
# Confusion matrix on full training data
