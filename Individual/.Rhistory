load_cricsheet_match <- function(path) {
js <- fromJSON(path)
innings_raw <- js$innings
# Extract innings info
innings <- map(innings_raw, function(inn) {
inn <- inn[[1]]  # dereference "1st innings", "2nd innings" etc.
tibble(
team = inn$team,
deliveries = list(inn$deliveries)
)
}) %>% bind_rows()
# Flatten ball-by-ball
balls <- innings %>%
mutate(inn_no = row_number()) %>%
unnest(deliveries) %>%
mutate(ball_id = names(deliveries)) %>%
unnest_wider(deliveries) %>%
separate(ball_id, into = c("over", "ball"), sep = "\\.", convert = TRUE)
# Compute innings summary
innings_summary <- balls %>%
group_by(inn_no, team) %>%
summarise(
runs = sum(as.numeric(as.list(runs)[["total"]]), na.rm = TRUE),
wickets = sum(!is.na(wicket.kind)),
.groups = "drop"
)
list(
meta = js$meta,
info = js$info,
balls = balls,
innings = innings_summary
)
}
exampleMatch <- load_cricsheet_match("matches/1460884.json")
load_cricsheet_match <- function(path) {
js <- fromJSON(path, simplifyVector = FALSE)
innings_raw <- js$innings
# Extract innings info
innings <- map(innings_raw, function(inn) {
inn <- inn[[1]]  # dereference "1st innings", "2nd innings" etc.
tibble(
team = inn$team,
deliveries = list(inn$deliveries)
)
}) %>% bind_rows()
# Flatten ball-by-ball
balls <- innings %>%
mutate(inn_no = row_number()) %>%
unnest(deliveries) %>%
mutate(ball_id = names(deliveries)) %>%
unnest_wider(deliveries) %>%
separate(ball_id, into = c("over", "ball"), sep = "\\.", convert = TRUE)
# Compute innings summary
innings_summary <- balls %>%
group_by(inn_no, team) %>%
summarise(
runs = sum(as.numeric(as.list(runs)[["total"]]), na.rm = TRUE),
wickets = sum(!is.na(wicket.kind)),
.groups = "drop"
)
list(
meta = js$meta,
info = js$info,
balls = balls,
innings = innings_summary
)
}
