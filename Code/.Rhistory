profitsRaw <- as.numeric(read.csv("profits.csv", header=FALSE))
profitsRaw <- as.numeric(read.csv("profits.csv", header=FALSE))
profits <- cumsum(profitsRaw)
ts.plot(profits)
dProfits <- diff(profits)
ts.plot(dProfits)
mean(dProfits)
t.test(dProfits)
d2Profits <- diff(profits, differences=2)
ts.plot(d2Profits)
mean(d2Profits)
acf(d2Profits)
var(d2Profits)
fit <- arima(profits, order=c(0, 2, 1))
# Plotting the model in black vs the original time series in red
ts.plot(profits)
lines(500:599, rep(1,100) * profits[500], col = 2)
lines(500:599, profits[500] + 3.846 * sqrt(1:100), col = 2)
lines(500:599, profits[500] - 3.846 * sqrt(1:100), col = 2)
