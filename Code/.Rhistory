## input: count data xs
## output: method of moments estimates of lambda and phi
compute.mom.estimate <- function(xs) {
## perform computations
## ...
return(c(lambda.mm, phi.mm))
}
compute.mom.estimate <- function(xs)
{
m1 = sum(xs) / count(xs)
m2 = sum(xs**2) / count(xs)
lambda.mm = m1
phi.mm = (m2 - m1 - m1**2) / m1
return(c(lambda.mm, phi.mm))
print(compute.mom.estimate(counts))
}
compute.mom.estimate <- function(xs)
{
m1 = sum(xs) / count(xs)
m2 = sum(xs**2) / count(xs)
lambda.mm = m1
phi.mm = (m2 - m1 - m1**2) / m1
return(c(lambda.mm, phi.mm))
compute.mom.estimate(counts)
}
