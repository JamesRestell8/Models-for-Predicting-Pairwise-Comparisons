method = "L-BFGS-B",
control = list(maxit = 1000, trace = 1),
)
negBin <- function(params, dat)
{
r = params[1]
p = params[2]
ll = 0
for (tk in 1:nrow(dat)) {
x <- dat[tk]
ll <- ll + choose(x+r-1, x)*(1-p)^x * p^r
}
return(ll)
}
result <- optim(
par = initial_parameters,
fn = function(params) -negBin(params, scores),
method = "L-BFGS-B",
control = list(maxit = 1000, trace = 1),
)
negBin <- function(params, dat)
{
r = params[1]
p = params[2]
ll = 0
for (tk in 1:nrow(dat)) {
x <- dat[tk]
ll <- ll + log(choose(x+r-1, x)) + x*log(1-p) + r * log(p)
}
return(ll)
}
negBin_ll <- function(params, data) {
r <- params[1]
p <- params[2]
# Constraints
if (r <= 0 || p <= 0 || p >= 1) return(Inf)
x <- data
# log PMF using gamma
ll <- lgamma(x + r) - lgamma(r) - lgamma(x + 1) +
r * log(p) + x * log(1 - p)
return(-sum(ll))  # return negative log-likelihood
}
